{
  "id": "./",
  "name": "Stickly · notas, tareas y contraseñas",
  "short_name": "Stickly",
  "description": "Notas, tareas, cuadernos, notas de voz, contraseñas y temporizador. Tus datos se quedan en tu dispositivo, cifrados.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#F8F7FB",
  "theme_color": "#6463AA",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nueva nota",
      "short_name": "Nota",
      "description": "Crear un post-it",
      "url": "./#/note/new",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calendario",
      "short_name": "Calendario",
      "description": "Ver tareas del día",
      "url": "./#/calendar",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Contraseñas",
      "short_name": "Bóveda",
      "description": "Abrir la bóveda cifrada",
      "url": "./#/passwords",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
